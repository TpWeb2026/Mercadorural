package views

import "strconv"

templ PublicacionesPropiasList(publicaciones []PublicacionVista) {
	if len(publicaciones) == 0 {
		<p class="empty-state">Todavía no publicaste ningún animal.</p>
	} else {
		<div class="card-list">
			for _, publicacion := range publicaciones {
				<article class="publication-card">
					<div class="publication-card__top">
						<h3>{ publicacion.Animal }</h3>
						<div class="publication-card__price-status">
							<span class="price">{ publicacion.Precio }</span>
							<span class="badge badge-active">En venta</span>
						</div>
					</div>
					<ul class="publication-meta">
						<li>Raza: { publicacion.Raza }</li>
						<li>Publicación #{ strconv.FormatInt(publicacion.ID, 10) }</li>
					</ul>
					<div class="card-actions">
						<a class="btn btn-secondary" href={ urlEditar(publicacion.ID) }>Editar</a>
						<form method="post" action={ urlEliminar("publicacion", publicacion.ID) }>
							<button type="submit" class="btn btn-danger">Eliminar</button>
						</form>
					</div>
				</article>
			}
		</div>
	}
}

templ PublicacionesAjenasList(publicaciones []PublicacionVista, puedeComprar bool) {
	if len(publicaciones) == 0 {
		<p class="empty-state">No hay publicaciones de otros usuarios.</p>
	} else {
		<div class="card-list">
			for _, publicacion := range publicaciones {
				<article class="publication-card">
					<div class="publication-card__top">
						<h3>{ publicacion.Animal }</h3>
						<div class="publication-card__price-status">
							<span class="price">{ publicacion.Precio }</span>
							<span class="badge badge-active">En venta</span>
						</div>
					</div>
					<ul class="publication-meta">
						<li>Raza: { publicacion.Raza }</li>
						<li>Vendedor: { publicacion.Vendedor }</li>
						<li>Publicación #{ strconv.FormatInt(publicacion.ID, 10) }</li>
					</ul>
					if puedeComprar {
						<div class="card-actions">
							<form method="post" action={ urlComprar(publicacion.ID) }>
								<button type="submit" class="btn btn-primary">Comprar</button>
							</form>
						</div>
					}
				</article>
			}
		</div>
	}
}
