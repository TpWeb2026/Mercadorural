package views

import "strconv"

templ VentasList(ventas []VentaVista) {
	if len(ventas) == 0 {
		<p class="empty-state empty-state--small">Todavía no hay ventas registradas.</p>
	} else {
		<div class="mini-list">
			for _, venta := range ventas {
				<div class="mini-item sale-item">
					<div class="mini-item__info">
						<span class="mini-item__title">Publicación #{ strconv.FormatInt(venta.PublicacionID, 10) } · { venta.Precio }</span>
						<span class="mini-item__detail">Comprador: { venta.Comprador } · Vendedor: { venta.Vendedor }</span>
					</div>
					<span class="sale-date">{ venta.Fecha }</span>
				</div>
			}
		</div>
	}
}
