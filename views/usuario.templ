package views

templ UsuarioForm(form UsuarioFormData) {
	<form method="post" action="/usuario" class="form-stack">
		<div class="field">
			<label for="usuario-nombre">Nombre</label>
			<input id="usuario-nombre" name="nombre" type="text" autocomplete="given-name" value={ form.Nombre } required/>
		</div>
		<div class="field">
			<label for="usuario-apellido">Apellido</label>
			<input id="usuario-apellido" name="apellido" type="text" autocomplete="family-name" value={ form.Apellido } required/>
		</div>
		<div class="field">
			<label for="usuario-contacto">Contacto</label>
			<input id="usuario-contacto" name="contacto" type="email" autocomplete="email" placeholder="correo@ejemplo.com" value={ form.Contacto }/>
		</div>
		<button type="submit" class="btn btn-secondary">Crear usuario</button>
	</form>
}

templ UsuarioList(usuarios []UsuarioVista) {
	if len(usuarios) == 0 {
		<p class="empty-state empty-state--small">Todavía no hay usuarios.</p>
	} else {
		<div class="mini-list">
			for _, usuario := range usuarios {
				<div class="mini-item">
					<div class="mini-item__info">
						<span class="mini-item__title">{ usuario.NombreCompleto }</span>
						<span class="mini-item__detail">{ usuario.Contacto }</span>
					</div>
					<form method="post" action={ urlEliminar("usuario", usuario.ID) }>
						<button type="submit" class="btn btn-danger">Eliminar usuario</button>
					</form>
				</div>
			}
		</div>
	}
}
